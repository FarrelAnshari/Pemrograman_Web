            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"ANM-004\",\n  \"title\": \"Jujutsu Kaisen: Shibuya Incident\",\n  \"type\": \"anime\",\n  \"genre\": \"Aksi, Supranatural, Shonen\",\n  \"rating\": 8.75,\n  \"synopsis\": \"Insiden besar di Shibuya yang melibatkan penyegelan Satoru Gojo.\",\n  \"is_available\": true,\n  \"total_episodes\": 23,\n  \"studio\": \"MAPPA\",\n  \"resolution\": \"1080p Full HD\",\n  \"has_sub_indo\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/media",
              "host": ["{{base_url}}"],
              "path": ["media"]
            }
          }
        },
        {
