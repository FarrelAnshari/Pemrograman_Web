{
  "info": {
    "_postman_id": "a7f2b4d0-91e4-4c6b-8a0f-1f3e5d7b9012",
    "name": "FlipPlay REST API (Laravel 12)",
    "description": "Koleksi pengujian Postman untuk FlipPlay REST API — lanjutan dari sistem PHP OOP Module_3.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Happy Path",
      "item": [
        {
          "name": "1. List All Media",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/media",
              "host": ["{{base_url}}"],
              "path": ["media"]
            }
          }
        },
        {
          "name": "2. Search Media by Title (Frieren)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/media?title=Frieren",
              "host": ["{{base_url}}"],
              "path": ["media"],
              "query": [
                { "key": "title", "value": "Frieren" }
              ]
            }
          }
        },
        {
          "name": "3. Filter Media by Type (anime)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/media?type=anime",
              "host": ["{{base_url}}"],
              "path": ["media"],
              "query": [
                { "key": "type", "value": "anime" }
              ]
            }
          }
        },
        {
          "name": "4. Create New Media (Anime)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
